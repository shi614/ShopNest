# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Local only: hosting services like Render set PORT themselves, so don't add it there
PORT=5002

# Frontend URL(s) allowed to call this API (comma-separated). Leave empty locally.
# On Render, set it to your Vercel URL, e.g. https://shopnest.vercel.app
CLIENT_URL=
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=<a-long-random-string>

# Gmail address + 16-character App Password (Google Account > Security > App passwords)
EMAIL_USER=you@gmail.com
EMAIL_PASS=<app-password-without-spaces>

# Cloudinary > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay > Settings > API Keys (rzp_test_... for test mode, rzp_live_... for real payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
